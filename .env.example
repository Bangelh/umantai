# .env.example — variables que UMANTAI lee (sin secretos reales).
#
# Copiar a `.env.local` para desarrollo o cargar en Netlify → Site configuration
# → Environment variables. Los valores de staging y producción van separados por
# contexto en Netlify; nunca se reutiliza el mismo bucket ni la misma base.

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://staging--umantai.netlify.app
NEXT_PUBLIC_SERVER_URL=https://staging--umantai.netlify.app
NEXT_PUBLIC_APP_URL=https://staging--umantai.netlify.app

# ── Base de datos (Supabase) ─────────────────────────────────────────────────
# Runtime: pooler en modo transacción (puerto 6543). Migraciones/seeds: directa
# o session (puerto 5432). Ver DEPLOYMENT.md.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
POSTGRES_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_DRIVER=pg

# En serverless cada instancia debe abrir UNA conexión: el pooler hace el resto.
PGPOOL_MAX=1
PGBETTER_AUTH_POOL_MAX=1
PGCONNECT_TIMEOUT=10

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=cambiar-por-32-caracteres-aleatorios
BETTER_AUTH_URL=https://staging--umantai.netlify.app
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── Payload CMS ──────────────────────────────────────────────────────────────
PAYLOAD_SECRET=cambiar-por-un-secreto-largo

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=cambiar-por-un-secreto-largo

# ── Email transaccional (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=

# ── Pagos (Mercado Pago) ─────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BILLING_PROVIDER=mercadopago
MP_WEBHOOK_SUPPORT_CAPTURE=true

# ── Imágenes ─────────────────────────────────────────────────────────────────
# `db` guarda los binarios en `media_assets` (bytea) y por eso consume los 500 MB
# de Supabase. `r2` lo evita, pero Cloudflare exige método de pago para habilitar
# R2 aunque el plan sea gratis: para staging sin tarjeta, dejar `db` y volumen bajo.
MEDIA_DRIVER=db
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=umantai-staging
R2_PUBLIC_BASE_URL=

# ── Supabase JS (solo si se usa Storage/Auth del cliente) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp y contacto ──────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_SUPPORT_PHONE=979363149
NEXT_PUBLIC_WHATSAPP_SUPPORT_MESSAGE=
NEXT_PUBLIC_WHATSAPP_SALES_PHONE=979363149
NEXT_PUBLIC_WHATSAPP_SALES_MESSAGE=

# ── Operación ────────────────────────────────────────────────────────────────
ADMIN_API_SECRET=
ALLOW_ADMIN_TOKEN_FALLBACK=false
SEED_OWNER_EMAIL=
COMMERCE_RESERVATION_TTL_MINUTES=30
BILLING_GRACE_DAYS=3

# ── Solo pruebas end-to-end (nunca en producción) ────────────────────────────
E2E_TEST_TOKEN=
